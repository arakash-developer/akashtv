{
  "name": "akash-tv",
  "productName": "AKASH TV",
  "version": "1.0.0",
  "description": "Turn a PC into a YouTube TV screen you control from your phone",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.akash.akashtv",
    "productName": "AKASH TV",
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" }
  }
}
